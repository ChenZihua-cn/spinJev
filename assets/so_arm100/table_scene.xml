<!--
  Pick-and-place scene: SO-ARM100 bolted at the back edge of a table, one target block in
  reach, one opaque panel that can be dropped over it.  The arm itself comes from so_arm100.xml.

  The base mesh rests exactly on z = 0, so the table top is z = 0.
  The occluder is non-colliding on purpose: it only removes pixels, it never blocks the arm.
  It hovers above the arm, so it is the first surface the overhead camera sees.
  Its pose is a mocap channel, so the task layer can place it per episode without recompiling.
  It stays in geom group 0: MuJoCo's default MjvOption hides groups 3-5, which is how the arm's
  collision meshes (group 3) stay out of renders.
-->
<mujoco model="so_arm100 table">
  <include file="so_arm100.xml" />

  <statistic center="0 -0.2 0.08" extent="0.5" />

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
    <rgba haze="0.15 0.25 0.35 1" />
    <global azimuth="-45" elevation="-25" />
  </visual>

  <asset>
    <texture
      type="skybox"
      builtin="gradient"
      rgb1="0.3 0.5 0.7"
      rgb2="0 0 0"
      width="512"
      height="3072"
    />
    <material name="tabletop" rgba="0.55 0.4 0.28 1" />
    <material name="target" rgba="0.85 0.2 0.2 1" />
    <material name="occluder" rgba="0.08 0.08 0.08 1" />
  </asset>

  <worldbody>
    <light type="directional" pos="0.3 -0.3 1.0" dir="-0.1 0.1 -1" diffuse="0.7 0.7 0.7" />

    <body name="table">
      <geom
        name="tabletop"
        type="box"
        size="0.40 0.50 0.01"
        pos="0 -0.35 -0.01"
        material="tabletop"
        friction="1.5 0.01 0.001"
      />
    </body>

    <!--
      Target block: 3 x 3 x 6 cm, standing on end. Not a styling choice -- measured on this
      asset (test/test_spine.py --profile), the two jaws only have a usable opening (>30 mm) at
      60-100 mm in front of the wrist, and they touch each other at ~40 mm. A 3 cm-tall block
      lying flat therefore cannot be gripped without driving the fingertips ~3 cm into the
      tabletop, which the guard forbids. Mass scaled with volume (0.56 g/cm3, as before).
    -->
    <body name="target" pos="0 -0.24 0.03">
      <freejoint name="target" />
      <geom
        name="target"
        type="box"
        size="0.015 0.015 0.03"
        mass="0.030"
        material="target"
        friction="1.5 0.01 0.001"
      />
    </body>

    <body name="occluder" mocap="true" pos="0 -0.24 0.30">
      <geom
        name="occluder"
        type="box"
        size="0.05 0.05 0.03"
        density="0"
        contype="0"
        conaffinity="0"
        material="occluder"
      />
    </body>

    <camera name="overhead" pos="0 -0.24 0.60" xyaxes="1 0 0 0 1 0" />
  </worldbody>
</mujoco>
